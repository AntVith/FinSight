## FinSight production env file. Copy to `.env.production` locally only when generating a production build,
## or (preferred) set these directly in your hosting dashboard (Vercel / Netlify / Cloudflare Pages).
##
## ANY value starting with VITE_ is statically inlined into the JavaScript bundle at build time.
## Treat them as PUBLIC. Never put backend secrets, JWT secrets, Plaid client_secret, etc. here.

# Public origin of the deployed Go API. No trailing slash.
VITE_API_URL=https://your-finsight-api.up.railway.app

# Optional demo lane. If you point this at a real account these credentials become public to anyone
# who views the JS bundle, so only ever set this to a seeded sandbox account that holds zero real data.
# Leave both unset to hide the demo button from production.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
