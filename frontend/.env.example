## FinSight Vite-facing variables (`import.meta.env.VITE_*` are inlined into the bundle at build time)
## Never rely on these for production secrets tied to banking. attackers can read any VITE_* value client-side.

# Base URL of the Go API (defaults to localhost:8080 if unset)
VITE_API_URL=http://localhost:8080

# Optional one-click sandbox demo lane. wires to POST /api/auth/login against a seeded Postgres user.
# Must mirror backend/.env's DEMO_USER_EMAIL / DEMO_USER_PASSWORD. The seed command (`go run ./cmd/seeddemo`)
# also pre-links First Platypus Bank via Plaid sandbox so the demo dashboard is non-empty on first click.
VITE_DEMO_EMAIL=demo@finsight.local
VITE_DEMO_PASSWORD=demoFinSight!2026
