PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

CLAUDE_API_KEY=
CLAUDE_MODEL=

# Quote URLs that contain &. Do not put search_path= in DATABASE_URL; psql rejects it as an unknown URI parameter; schemas are qualified as finsight.* in SQL.
DATABASE_URL=
PORT=8080
ENCRYPTION_KEY=

# bcrypt password hashes plus HS256 access JWTs plus opaque rotated refresh tokens
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_BCRYPT_COST=10

# Seeded demo account consumed by `go run ./cmd/seeddemo` (also mirrored to frontend VITE_DEMO_*)
# Backend policy enforces password length >= 10. The seed command auto-links First Platypus Bank.
DEMO_USER_EMAIL=demo@finsight.local
DEMO_USER_PASSWORD=demoFinSight!2026

# Comma-separated origins permitted by CORS. Leave unset to fall back to localhost:3000/5173 for dev.
# Production example: ALLOWED_ORIGINS=https://finsight.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=
